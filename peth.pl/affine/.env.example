SERVICE_NAME=affine
CONTAINER_DIR=
TZ=Europe/Berlin
RESTART_POLICY=unless-stopped
LOG_MAX_SIZE=1m
LOG_MAX_FILES=3

AFFINE_REVISION=stable
VIRTUAL_HOST=

DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_DATABASE}
POSTGRES_INITDB_ARGS=--data-checksums