SERVICE_NAME=gpsno-server
CONTAINER_DIR=
TZ=Europe/Berlin
RESTART_POLICY=unless-stopped
LOG_MAX_SIZE=1m
LOG_MAX_FILES=3

VIRTUAL_HOST=
FLASK_SECRET_KEY=

MQTT_HOST=${MQTT_HOST}
MQTT_PORT=${MQTT_PORT}
MQTT_USER=${MQTT_USER}
MQTT_PASSWORD=${MQTT_PASSWORD}
DB_PATH=/data/gpsno_mappings.db
WEB_PORT=5000
FLASK_SECRET_KEY=${FLASK_SECRET_KEY}